# Groww Mutual Fund RAG Assistant — Environment Variables
# Copy this file to .env and fill in your values.

# ── Authentication ──────────────────────────────────────────────────────────
# Google AI Studio API key (get one free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gemini Model Configuration ──────────────────────────────────────────────
# Embedding model used to index chunks and embed queries
EMBEDDING_MODEL=models/gemini-embedding-001

# LLM model used to generate answers
GEMINI_LLM_MODEL=gemini-2.5-flash

# ── Vector Database Configuration ───────────────────────────────────────────
# Path to the persistent ChromaDB storage directory (relative to project root)
VECTOR_STORE_PATH=data/vector_store

# Name of the ChromaDB collection
CHROMA_COLLECTION=mutual_funds

# Maximum cosine distance for a result to be considered relevant (0.0 = identical, 1.0 = unrelated)
DISTANCE_THRESHOLD=0.45

# Number of top chunks to retrieve per query
RETRIEVAL_TOP_K=3

# ── Scheduler Configuration ──────────────────────────────────────────────────
# Daily refresh time in HH:MM format (24-hour, local server time)
REFRESH_TIME=00:00

# ── Backend Server Configuration ────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
